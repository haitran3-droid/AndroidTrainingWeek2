<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/toolsScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    tools:showIn="@layout/activity_playground">

    <com.example.canvasplayground.LessonColumn
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include layout="@layout/control_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:text="@string/wide_heading"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:text="@string/wide_help"
            android:textColor="@color/muted"
            android:textSize="15sp" />
    </com.example.canvasplayground.LessonColumn>
</ScrollView>