<com.example.canvasplayground.TouchLessonFrame xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/touchFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    tools:showIn="@layout/activity_playground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_card"
        android:orientation="vertical">

        <TextView
            android:id="@+id/canvasStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:importantForAccessibility="no"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <com.example.canvasplayground.LearningCanvasView
            android:id="@+id/canvasView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="16dp"
            app:circleColor="@color/circle_blue"
            app:circleLabel="@string/label_intern"
            app:circleRadius="40dp"
            app:showGrid="true" />
    </LinearLayout>
</com.example.canvasplayground.TouchLessonFrame>