<resources>
    <style name="Theme.CanvasPlaygroundXml" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/circle_blue</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/background</item>
    </style>
    <style name="ActionButton">
        <item name="android:background">@drawable/bg_action</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/action_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:layout_margin">3dp</item>
    </style>
    <style name="LabelSource">
        <item name="android:background">@drawable/bg_action</item>
        <item name="android:textColor">@color/action_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">10dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:clickable">true</item>
        <item name="android:longClickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:layout_margin">3dp</item>
    </style>
</resources>