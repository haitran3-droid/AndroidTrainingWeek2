<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="@color/disabled" /><corners android:radius="10dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/action_pressed" /><corners android:radius="10dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/action" /><corners android:radius="10dp" /></shape>
    </item>
</selector>